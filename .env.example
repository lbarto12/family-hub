# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Game server poller. Defaults suit a host that is already on the tailnet with
# the game servers; every value is optional.
# GAME_POLL_ENABLED="true"          # set false to run the app without polling
# GAME_SSH_BIN="tailscale"          # or "ssh" for a plain keyed connection
# GAME_SSH_ARGS="ssh"               # e.g. "-o BatchMode=yes -o ConnectTimeout=5" for plain ssh
# GAME_SSH_TARGET="user@gaming"
# GAME_POLL_INTERVAL_MS="5000"
# GAME_PROBE_TIMEOUT_MS="4000"      # keep below the poll interval
# GAME_RETENTION_DAYS="90"
# GAME_SWEEP_INTERVAL_MS="3600000"
